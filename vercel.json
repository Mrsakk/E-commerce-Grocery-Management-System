{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/(css|js|images|storage|build|favicon.ico|robots.txt)(.*)",
            "dest": "/public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://e-commerce-grocery-management-syste.vercel.app",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "CACHE_STORE": "database",
        "SESSION_DRIVER": "database",
        "SESSION_CONNECTION": "pgsql",
        "SESSION_SECURE_COOKIE": "true",
        "SESSION_DOMAIN": ".vercel.app",
        "SESSION_SAME_SITE": "lax",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "pgsql",
        "DB_URL": "postgresql://neondb_owner:npg_DykmTz1qoM4Q@ep-aged-glade-aw7jxgua-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require",
        "DB_HOST": "ep-aged-glade-aw7jxgua-pooler.c-12.us-east-1.aws.neon.tech",
        "DB_PORT": "5432",
        "DB_DATABASE": "neondb",
        "DB_USERNAME": "neondb_owner",
        "DB_PASSWORD": "npg_DykmTz1qoM4Q",
        "DB_SSLMODE": "require",
        "DB_NEON_ENDPOINT": "ep-aged-glade-aw7jxgua-pooler"
    }
}
